# Dashboard startup requires a generated 32–256 printable ASCII secret; see docs/SECURITY_HARDENING.md.
WHALE_ADMIN_TOKEN=replace-with-a-long-random-password
WHALE_DATABASE_URL=sqlite:///runtime/whale.sqlite3
WHALE_TELEGRAM_TOKEN=
WHALE_TELEGRAM_OWNER_ID=
WHALE_WEBHOOK_SECRET=
WHALE_PUBLIC_URL=
WHALE_RPC_ETHEREUM=
WHALE_RPC_SOLANA=
WHALE_RPC_ARBITRUM=
WHALE_RPC_BASE=
WHALE_RPC_POLYGON=
WHALE_RPC_BSC=
WHALE_RPC_RPS=3
WHALE_HELIUS_WEBHOOK_SECRET=
WHALE_NANSEN_KEY=
WHALE_DUNE_KEY=
WHALE_HELIUS_KEY=
WHALE_RPC_SOLANA_FALLBACKS=
WHALE_RPC_ETHEREUM_FALLBACKS=
WHALE_RPC_ARBITRUM_FALLBACKS=
WHALE_RPC_BASE_FALLBACKS=
WHALE_RPC_POLYGON_FALLBACKS=
WHALE_RPC_BSC_FALLBACKS=
# Conservative local caps; they do not replace provider-side credit accounting.
WHALE_HELIUS_RPC_BUDGET=850000
WHALE_RPC_MONTHLY_BUDGET=1000000
WHALE_PUBLIC_RPC_BUDGET=150000
WHALE_NANSEN_DAILY_CREDITS=10
WHALE_ZERION_KEY=
WHALE_ZERION_DAILY_CALLS=10
WHALE_HYPERLIQUID_MONTHLY_CALLS=1000000
WHALE_AUTO_REPORTS=true
# chain:contract/mint -> quote symbol; chain:address -> verified exchange label
WHALE_QUOTE_ASSETS_JSON={}
WHALE_EXCHANGE_ADDRESSES_JSON={}
# Example: {"bybit:0xYOUR_AUTHORIZED_ADDRESS":{"apiKey":"...","secret":"..."}}
# OKX needs password (API passphrase). This is a user-defined authorized account mapping.
WHALE_EXCHANGE_ACCOUNTS_JSON={}
WHALE_DUNE_DAILY_CALLS=5
WHALE_PRICES_ENABLED=true
WHALE_PRICE_MONTHLY_CALLS=100000
WHALE_MIN_PRICE_LIQUIDITY_USD=1000
# Optional verified wrapped native contracts/mints for reference spot valuation.
WHALE_NATIVE_PRICE_TOKENS_JSON={}
WHALE_LIQ_CRITICAL_PCT=2
WHALE_LIQ_NEAR_PCT=5
WHALE_RISK_MAX_AGE_SECONDS=900
WHALE_SOURCE_COOLDOWN_SECONDS=120
WHALE_RISK_REPORT_TELEGRAM=true
# Birdeye Standard: documented 30,000 CU/month; account/API key required.
WHALE_BIRDEYE_KEY=
WHALE_BIRDEYE_MONTHLY_CU=27000
WHALE_BIRDEYE_DAILY_CU=1000
WHALE_BIRDEYE_PRICE_CACHE_SECONDS=600
WHALE_BIRDEYE_RESEARCH_CACHE_SECONDS=86400
WHALE_BIRDEYE_MAX_PRICE_AGE_SECONDS=900
# Screening: six completed scans -> 1h; four automatic hourly blocks -> 4h.
WHALE_SCREEN_AUTO_REPORTS=true
WHALE_SCREEN_MIN_COVERAGE_PCT=70
WHALE_SCREEN_SIDEWAYS_RANGE_PCT=1.5
# Explicit links let spot contracts and same-underlying perpetuals combine safely.
# Example: {"hyperliquid:ETH":"ethereum:native"}
WHALE_SCREEN_ASSET_LINKS_JSON={}
WHALE_SCREEN_MAX_AI_ASSETS=8
WHALE_SCREEN_AI_MODE=consensus
WHALE_SCREEN_AI_TIMEOUT_SECONDS=25
WHALE_SCREEN_GROQ_KEY=
WHALE_SCREEN_GROQ_MODEL=
WHALE_SCREEN_GROQ_DAILY_CALLS=60
WHALE_SCREEN_GEMINI_KEY=
WHALE_SCREEN_GEMINI_MODEL=
WHALE_SCREEN_GEMINI_DAILY_CALLS=60
WHALE_SCREEN_OPENROUTER_KEY=
WHALE_SCREEN_OPENROUTER_MODEL=openrouter/free
WHALE_SCREEN_OPENROUTER_DAILY_CALLS=20
# Official Binance / Bybit / OKX public market APIs are on by default.
WHALE_MARKETS_ENABLED=true
WHALE_MARKET_AUTO_REPORTS=true
WHALE_MARKET_CACHE_SECONDS=600
WHALE_MARKET_MAX_SYMBOLS=10
WHALE_MARKET_RPS=2
WHALE_MARKET_TIMEOUT_SECONDS=8
WHALE_MARKET_CYCLE_TIMEOUT_SECONDS=60
WHALE_MARKET_MAX_AGE_SECONDS=1200
# Local actual-request budget PER EXCHANGE/month, not an exchange entitlement.
WHALE_MARKET_MONTHLY_CALLS=100000
# Optional public MARKET_DATA key; never provide account/trading credentials here.
WHALE_BINANCE_MARKET_KEY=
# Exact owner-verified asset -> exchange base symbol. Native coins map automatically.
# Example: {"ethereum:0xYOUR_TOKEN_CONTRACT":"PEPE","perp:hyperliquid:ETH":"ETH"}
WHALE_MARKET_ASSET_LINKS_JSON={}

# Shared Binance Futures / Bybit liquidity engine.
WHALE_LIQUIDITY_ENABLED=true
WHALE_LIQUIDITY_MODE=live
# Four venue/coin pairs generally means two coins across both venues.
WHALE_LIQUIDITY_MAX_MARKETS=4
# Empty disables raw tick recording. Durable scan summaries still use the wallet DB.
WHALE_LIQUIDITY_JOURNAL=runtime/liquidity-events.sqlite
WHALE_LIQUIDITY_CONFIG=
WHALE_LIQUIDITY_AUTO_REPORTS=true
# Extra candidate alerts require explicit opt-in; normal scan summaries are separate.
WHALE_LIQUIDITY_ALERTS=false

# Read-only order study for imported futures account/coin pairs.
WHALE_ORDERS_ENABLED=true
WHALE_MAX_ORDERS_PER_WALLET=200
WHALE_ORDER_STATUS_BUDGET=20
WHALE_ORDER_AUTO_REPORTS=true
